# Normalize line endings across Windows/macOS/Linux contributors. Without this
# Vercel (Linux) and a Windows workstation see "every file changed" diffs.
* text=auto eol=lf

# Source files — always LF, even on Windows
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.woff binary
*.woff2 binary
