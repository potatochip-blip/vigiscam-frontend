# VIGISCAM frontend environment — copy to .env.local and fill in.
# NEVER commit a real .env.local — it's in .gitignore.

# ─── Backend API ─────────────────────────────────────────────────────────────
# Base URL of the deployed VIGISCAM backend, including the /api/v1 prefix.
# Dev:  https://ca-vigiscam-dev-backend.lemonwater-a8a5ddd4.westus3.azurecontainerapps.io/api/v1
# Prod: https://api.vigiscam.com/api/v1   (TBD when prod env stands up)
NEXT_PUBLIC_API_URL=https://ca-vigiscam-dev-backend.lemonwater-a8a5ddd4.westus3.azurecontainerapps.io/api/v1

# ─── Auth ────────────────────────────────────────────────────────────────────
# Secret used to sign the cookie that wraps the backend JWT. 32+ random bytes.
# Generate locally with: `openssl rand -hex 32`
SESSION_COOKIE_SECRET=replace-me-with-32-bytes-of-random

# Cookie domain — leave empty for localhost; set to .vigiscam.com in prod so
# the cookie spans api.vigiscam.com and www.vigiscam.com.
SESSION_COOKIE_DOMAIN=

# ─── Optional ────────────────────────────────────────────────────────────────
# Vercel Analytics is on by default via the package; nothing to configure.
